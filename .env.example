DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-random-secret"

# The site's single admin — /admin is only reachable when the signed-in
# user's account email matches this exactly.
ADMIN_EMAIL="you@example.com"

# Shared with .github/workflows/nascar-sync.yml's CRON_SECRET repo secret —
# Vercel Cron sends this automatically once set here; the GitHub Actions
# workflow sends it from its own copy, so both must be kept equal by hand.
CRON_SECRET="replace-with-a-random-secret"

# Resend (https://resend.com) — powers password reset emails and the
# sync-failure admin alert. Without a domain verified in Resend, the
# default sender below can only deliver to the email address the Resend
# account itself was created with. Leaving this unset doesn't break the
# app — emails just get logged to the console instead of sent.
RESEND_API_KEY="re_..."
EMAIL_FROM="Fantasy NASCAR HQ <onboarding@resend.dev>"

# Vercel Blob (https://vercel.com/docs/storage/vercel-blob) — powers
# profile picture and league icon uploads (src/app/api/upload/route.ts).
# On Vercel this is injected automatically once a Blob store is connected
# to the project; for local dev, run `vercel env pull .env.local` (or copy
# the value from the project's Storage tab). Uploads fail without it —
# everything else in the app works fine.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
