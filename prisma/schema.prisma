// Fantasy NASCAR HQ — starter database schema
// This is a first draft of the data model from the backend plan, written in
// Prisma's schema language. Hand this to Claude Code as a starting point —
// it will very likely suggest small refinements as the app takes shape,
// and that's expected and fine.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma7.config.ts (Prisma 7 moved it out of the
// schema); the client itself connects via a driver adapter — see src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ---------- Accounts & Leagues ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  // Null passwordHash means the account (e.g. from a historical data
  // import) hasn't been claimed with a username/password yet.
  username     String? @unique
  passwordHash String?

  // Email me when a race I've picked in gets results posted (see
  // notifyResultsPostedIfDue in src/lib/raceSync.ts). The only
  // notification preference wired to an actual send today — more can be
  // added here as more triggers exist to opt into.
  notifyResultsEmail Boolean @default(true)

  memberships         LeagueMembership[]
  picks               Pick[]
  passwordResetTokens PasswordResetToken[]
}

// A single-use, expiring password reset link. tokenHash is the SHA-256 of
// the random token actually emailed to the user — only the hash is stored,
// same reasoning as a password hash, so a database leak alone can't be used
// to take over an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Singleton row (fixed id) tracking the last time the sync-failure admin
// alert email went out, so a persistent outage sends one email an hour
// instead of one every ~15-minute cron tick.
model SyncAlertState {
  id            String    @id @default("singleton")
  lastAlertedAt DateTime?
}

enum LeagueType {
  PICKEM
  TIERED_DRAFT
}

// Only meaningful for PICKEM leagues — TIERED_DRAFT has no cross-player
// pick restrictions, so no order to compute. SNAKE/ROTATE both start from
// the commissioner's base order (League.pickOrder); the STANDINGS modes
// recompute the order fresh each week from cumulative points entering
// that week, falling back to the base order for ties (week 1, all at 0).
enum PickOrderMode {
  SNAKE
  ROTATE
  STANDINGS_FIRST_TO_LAST
  STANDINGS_LAST_TO_FIRST
}

model League {
  id         String     @id @default(cuid())
  name       String
  type       LeagueType
  ownerId    String
  // Share link for joining — regenerable, so it's not derived from name/id.
  inviteCode String     @unique @default(cuid())
  createdAt  DateTime   @default(now())

  // Weekly pick order for PICKEM leagues (see src/lib/pickOrder.ts). Unset
  // until the commissioner configures it from league settings; until then,
  // pick order falls back to membership join order.
  pickOrderMode PickOrderMode @default(SNAKE)
  // Ordered array of member userIds (JSON string[]) — the commissioner's
  // base draft order. Sanitized against current membership on every read,
  // so a departed member never blocks the list and a new member is always
  // appended automatically.
  pickOrder     Json?

  memberships   LeagueMembership[]
  ruleSets      RuleSet[]
  leagueSeasons LeagueSeason[]
  picks         Pick[]
}

enum MembershipRole {
  OWNER
  MEMBER
}

model LeagueMembership {
  id        String         @id @default(cuid())
  leagueId  String
  userId    String
  role      MembershipRole @default(MEMBER)
  // Used as the join-order fallback for pick order (see
  // src/lib/pickOrder.ts) when a league hasn't set a base order yet.
  createdAt DateTime       @default(now())

  league League @relation(fields: [leagueId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([leagueId, userId])
}

// ---------- Rules (versioned — never edited in place once a season uses it) ----------

model RuleSet {
  id        String   @id @default(cuid())
  leagueId  String
  label     String // e.g. "2026 Season Rules"
  // Holds a PickemRuleSetConfig or TieredDraftRuleSetConfig (see
  // src/lib/scoring.ts / src/lib/tieredDraft.ts), depending on the parent
  // League's type.
  config    Json
  createdAt DateTime @default(now())

  league        League         @relation(fields: [leagueId], references: [id])
  leagueSeasons LeagueSeason[]
}

// The real-world schedule for one year — shared across every league, not
// owned by any single one. A league takes part in it via LeagueSeason.
model Season {
  id   String @id @default(cuid())
  year Int    @unique

  races         Race[]
  leagueSeasons LeagueSeason[]
}

// Join record: one league's participation in one shared Season, scored
// under one of that league's own RuleSets.
model LeagueSeason {
  id        String @id @default(cuid())
  leagueId  String
  seasonId  String
  ruleSetId String

  league  League  @relation(fields: [leagueId], references: [id])
  season  Season  @relation(fields: [seasonId], references: [id])
  ruleSet RuleSet @relation(fields: [ruleSetId], references: [id])

  @@unique([leagueId, seasonId])
}

// ---------- Drivers & Races (shared across every league) ----------

model Driver {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  raceResults           RaceResult[]
  stageResults          StageResult[]
  qualifyingResults     QualifyingResult[]
  tierAssignments       DriverTierAssignment[]
  raceEntries           RaceEntry[]
  picks                 Pick[]
  historicalRaceResults HistoricalRaceResult[]
}

// Archival, pre-app-history results — imported once from NASCAR's feed to
// give the auto-tier formula's "track history" component real signal from
// day one, rather than starting neutral for every driver. Deliberately
// decoupled from Race/Season/RaceResult: this data never belongs to a
// League, was never entered/scored through the app, and has no entry
// list, qualifying, or stage data — reusing the live tables just to get
// the trackName-matching logic for free would risk this archival data
// leaking into schedule pages, league scoring, or the sync cron, none of
// which scope by anything that would exclude it. trackName is matched the
// same way (normalizeTrackName) as the live schedule sync.
model HistoricalRaceResult {
  id                String @id @default(cuid())
  year              Int
  trackName         String
  finishingPosition Int
  driverId          String

  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([year, trackName, driverId])
  @@index([trackName])
}

enum RaceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETE
}

model Race {
  id   String @id @default(cuid())
  // Season-order race number (1-based). The authoritative ordinal for a race
  // within its season — dates may be estimated, week is not.
  week Int

  seasonId     String
  // NASCAR's own event name ("Bass Pro Shops Night Race"), despite the
  // field name — see venueName for the physical track ("Bristol Motor
  // Speedway"). Kept as-is rather than renamed; too many call sites treat
  // this as the race's display name already.
  trackName    String
  // The physical venue, separate from trackName above. Nullable: only
  // populated once a schedule sync captures it (see
  // syncSeasonScheduleWithNascarFeed/syncRaceWithNascarFeed) — older or
  // not-yet-synced races won't have it until their next sync.
  venueName    String?
  date         DateTime
  // When qualifying happens for this race — nullable since older/seeded
  // races have no real qualifying data. Drives both the Tiered Lineup
  // league's initial lock (2am Pacific on this date) and a Pick'em league's
  // optional "lock before qualifying" timing; a race with no qualifyingAt
  // set falls back to locking the same as "before race start" everywhere.
  qualifyingAt DateTime?
  fieldSize    Int
  stage1Length Int?
  stage2Length Int?
  status       RaceStatus @default(SCHEDULED)
  // True for exhibition races (e.g. the All-Star race) that don't count toward
  // the standard scoring formula.
  isNonPoints  Boolean    @default(false)

  // cf.nascar.com's own numeric id for this race, once matched — lets
  // entries/qualifying/results be pulled automatically instead of entered
  // by hand. nascarSeriesId defaults to Cup (1); nullable/unmatched until
  // a schedule sync (or a commissioner) links it.
  nascarRaceId   Int?      @unique
  nascarSeriesId Int       @default(1)
  lastSyncedAt   DateTime?

  // Set the first time notifyResultsPostedIfDue actually sends the
  // "results are posted" email for this race, so a later re-sync or a
  // commissioner's correction never re-sends it.
  resultsNotifiedAt DateTime?

  season            Season                 @relation(fields: [seasonId], references: [id])
  results           RaceResult[]
  stageResults      StageResult[]
  qualifyingResults QualifyingResult[]
  tierAssignments   DriverTierAssignment[]
  raceEntries       RaceEntry[]
  picks             Pick[]

  @@unique([seasonId, week])
}

model RaceResult {
  id                String  @id @default(cuid())
  raceId            String
  driverId          String
  finishingPosition Int
  dnf               Boolean @default(false)
  // Nullable enrichment from synced data — not used by any scoring formula
  // today, but cheap to capture now for stats/future rules rather than
  // adding another migration later.
  lapsLed           Int?

  race   Race   @relation(fields: [raceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([raceId, driverId])
}

// The announced field for a race week — published before qualifying,
// shared/site-wide like RaceResult. Scopes driver-selection lists (tier
// assignment, Pick'em picks) to who's actually entered once known, rather
// than every driver the site has ever seen.
model RaceEntry {
  id           String  @id @default(cuid())
  raceId       String
  driverId     String
  carNumber    Int?
  teamName     String?
  manufacturer String?

  race   Race   @relation(fields: [raceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([raceId, driverId])
}

// Top-10 finishers of one stage. position is that stage's finishing
// order (1-10) — the original unique([raceId, stageNumber]) only allowed
// a single row per stage, which couldn't represent a top-10 at all; it's
// replaced with one constraint per invariant (a slot can't be claimed
// twice, a driver can't appear twice in the same stage).
model StageResult {
  id          String @id @default(cuid())
  raceId      String
  stageNumber Int
  position    Int
  driverId    String

  race   Race   @relation(fields: [raceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([raceId, stageNumber, position])
  @@unique([raceId, stageNumber, driverId])
}

// A driver's official qualifying finishing position for one race — shared,
// site-wide fact like RaceResult/StageResult. Drives both the Tiered
// Lineup league's qualifying points and its weekly A/B/C tier assignment.
model QualifyingResult {
  id                 String @id @default(cuid())
  raceId             String
  driverId           String
  qualifyingPosition Int

  race   Race   @relation(fields: [raceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([raceId, driverId])
}

// ---------- Tiers (Tiered Lineup league type only) ----------

// The three fixed performance tiers Tiered Lineup leagues draft from each
// week — not league-configurable, unlike Pick'em's rules.
enum DriverTier {
  A
  B
  C
}

// AUTO rows are free for the background auto-tier refresh (see
// tierRanking.ts) to recompute and overwrite as new entries/results come
// in; MANUAL marks a commissioner's deliberate hand-edit via the tiers
// form, which the refresh leaves alone until it's cleared by another
// auto-assign or by the race locking.
enum TierAssignmentSource {
  AUTO
  MANUAL
}

// Which tier a driver sits in for one specific race week — shared, site-wide
// (every Tiered Lineup league drafts from the same weekly tiers), re-set
// every week.
model DriverTierAssignment {
  id       String               @id @default(cuid())
  raceId   String
  driverId String
  tier     DriverTier
  source   TierAssignmentSource @default(AUTO)

  race   Race   @relation(fields: [raceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([raceId, driverId])
}

// ---------- Picks & Scoring ----------

// One row per driver a user rosters for a race. Pick'em leagues: one row
// per user per race per RuleSet.picksPerWeek slot. Tiered Lineup leagues:
// 8 rows per user per race — pickNumber 1-4 are the starter slots (Tier A,
// Tier B x2, Tier C), 5-8 are the matching bench slots (see
// TIERED_LINEUP_SLOTS in src/lib/tieredDraft.ts for the fixed mapping).
model Pick {
  id         String @id @default(cuid())
  leagueId   String
  userId     String
  raceId     String
  pickNumber Int    @default(1)
  driverId   String

  league League @relation(fields: [leagueId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  race   Race   @relation(fields: [raceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  score Score?

  // One pick per user per race per pick slot per league — was previously
  // scoped down to driverId instead of pickNumber, which let a user hold
  // two different-driver picks for the same week under the same slot.
  @@unique([leagueId, userId, raceId, pickNumber])
}

model Score {
  id String @id @default(cuid())

  pickId String @unique

  // Finish position and its derived components are only known once results
  // are resolved and reconciled; null (with needsReview set) means the
  // source data for this pick couldn't be fully resolved yet.
  finishPosition     Int?
  baseScore          Int?
  winBonus           Int?
  // Trusted regardless of needsReview: recorded directly from the league's
  // historical records rather than derived from finishPosition.
  stageBonus         Int
  // Tiered Lineup leagues only: this driver's qualifying result and the
  // points it earned (every rostered driver scores qualifying points,
  // starter or bench). Both stay null/0 for Pick'em picks.
  qualifyingPosition Int?
  qualifyingBonus    Int     @default(0)
  total              Int
  needsReview        Boolean @default(false)

  pick Pick @relation(fields: [pickId], references: [id])
}
